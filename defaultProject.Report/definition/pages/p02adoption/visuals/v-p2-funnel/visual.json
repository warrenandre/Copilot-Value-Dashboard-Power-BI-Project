{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "v-p2-funnel",
  "position": {
    "x": 0,
    "y": 295,
    "z": 8000,
    "height": 380,
    "width": 800,
    "tabOrder": 8000
  },
  "visual": {
    "visualType": "funnel",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "ValueChain"
                    }
                  },
                  "Property": "StepName"
                }
              },
              "queryRef": "ValueChain.StepName",
              "nativeQueryRef": "ValueChain.StepName",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Value Chain Count"
                }
              },
              "queryRef": "_Measures.Value Chain Count",
              "nativeQueryRef": "Value Chain Count"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "visualTooltip": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "section": {
              "expr": {
                "Literal": {
                  "Value": "'pt-value-chain-count'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}