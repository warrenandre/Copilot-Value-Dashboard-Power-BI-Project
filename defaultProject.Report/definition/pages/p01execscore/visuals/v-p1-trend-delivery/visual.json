{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "v-p1-trend-delivery",
  "position": {
    "x": 640,
    "y": 530,
    "z": 14000,
    "height": 250,
    "width": 630,
    "tabOrder": 14000
  },
  "visual": {
    "visualType": "lineClusteredColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimDate"
                    }
                  },
                  "Property": "YearMonth"
                }
              },
              "queryRef": "DimDate.YearMonth",
              "nativeQueryRef": "DimDate.YearMonth",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Deployments"
                }
              },
              "queryRef": "_Measures.Deployments",
              "nativeQueryRef": "Deployments"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Median PR Cycle Time (hrs)"
                }
              },
              "queryRef": "_Measures.Median PR Cycle Time (hrs)",
              "nativeQueryRef": "Median PR Cycle Time (hrs)"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "visualTooltip": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "section": {
              "expr": {
                "Literal": {
                  "Value": "'pt-deployments'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}