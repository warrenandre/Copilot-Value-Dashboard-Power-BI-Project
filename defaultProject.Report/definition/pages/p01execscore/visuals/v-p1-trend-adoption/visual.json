              "nativeQueryRef": "DimDate.WeekStart",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Active Users"
                }
              },
              "queryRef": "_Measures.Active Users",
              "nativeQueryRef": "Active Users"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Sustained Users"
                }
              },
              "queryRef": "_Measures.Sustained Users",
              "nativeQueryRef": "Sustained Users"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "visualTooltip": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "section": {
              "expr": {
                "Literal": {
