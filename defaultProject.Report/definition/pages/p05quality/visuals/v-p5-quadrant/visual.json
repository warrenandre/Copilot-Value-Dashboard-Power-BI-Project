{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "v-p5-quadrant",
  "position": {
    "x": 0,
    "y": 220,
    "z": 6000,
    "height": 420,
    "width": 950,
    "tabOrder": 6000
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimBusinessUnit"
                    }
                  },
                  "Property": "Team"
                }
              },
              "queryRef": "DimBusinessUnit.Team",
              "nativeQueryRef": "DimBusinessUnit.Team",
              "active": true
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "PRs Merged"
                }
              },
              "queryRef": "_Measures.PRs Merged",
              "nativeQueryRef": "PRs Merged"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Median PR Cycle Time (hrs)"
                }
              },
              "queryRef": "_Measures.Median PR Cycle Time (hrs)",
              "nativeQueryRef": "Median PR Cycle Time (hrs)",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Change Failure Rate"
                }
              },
              "queryRef": "_Measures.Change Failure Rate",
              "nativeQueryRef": "Change Failure Rate"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "visualTooltip": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "section": {
              "expr": {
                "Literal": {
                  "Value": "'pt-prs-merged'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}