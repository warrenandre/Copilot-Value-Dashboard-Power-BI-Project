                }
              },
              "queryRef": "DimDate.YearMonth",
              "nativeQueryRef": "DimDate.YearMonth",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimBusinessUnit"
                    }
                  },
                  "Property": "BusinessUnit"
                }
              },
              "queryRef": "DimBusinessUnit.BusinessUnit",
              "nativeQueryRef": "DimBusinessUnit.BusinessUnit"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
