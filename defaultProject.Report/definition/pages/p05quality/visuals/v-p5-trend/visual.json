                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Escaped Defects"
                }
              },
              "queryRef": "_Measures.Escaped Defects",
              "nativeQueryRef": "Escaped Defects"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Rework Rate"
                }
              },
              "queryRef": "_Measures.Rework Rate",
              "nativeQueryRef": "Rework Rate"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "visualTooltip": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "section": {
              "expr": {
                "Literal": {
                  "Value": "'pt-escaped-defects'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
