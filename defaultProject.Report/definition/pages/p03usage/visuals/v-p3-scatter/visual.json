{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "v-p3-scatter",
  "position": {
    "x": 960,
    "y": 220,
    "z": 8000,
    "height": 420,
    "width": 960,
    "tabOrder": 8000
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimBusinessUnit"
                    }
                  },
                  "Property": "Team"
                }
              },
              "queryRef": "DimBusinessUnit.Team",
              "nativeQueryRef": "DimBusinessUnit.Team",
              "active": true
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Active Users"
                }
              },
              "queryRef": "_Measures.Active Users",
              "nativeQueryRef": "Active Users"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Sustained Usage %"
                }
              },
              "queryRef": "_Measures.Sustained Usage %",
              "nativeQueryRef": "Sustained Usage %",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Median PR Cycle Time (hrs)"
                }
              },
              "queryRef": "_Measures.Median PR Cycle Time (hrs)",
              "nativeQueryRef": "Median PR Cycle Time (hrs)"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "visualTooltip": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "section": {
              "expr": {
                "Literal": {
                  "Value": "'pt-active-users'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}