{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "v-p3-feature-bar",
  "position": {
    "x": 0,
    "y": 220,
    "z": 7000,
    "height": 420,
    "width": 950,
    "tabOrder": 7000
  },
  "visual": {
    "visualType": "hundredPercentStackedBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimBusinessUnit"
                    }
                  },
                  "Property": "Team"
                }
              },
              "queryRef": "DimBusinessUnit.Team",
              "nativeQueryRef": "DimBusinessUnit.Team",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimFeature"
                    }
                  },
                  "Property": "FeatureName"
                }
              },
              "queryRef": "DimFeature.FeatureName",
              "nativeQueryRef": "DimFeature.FeatureName"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Suggestions Accepted"
                }
              },
              "queryRef": "_Measures.Suggestions Accepted",
              "nativeQueryRef": "Suggestions Accepted"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "visualTooltip": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "section": {
              "expr": {
                "Literal": {
                  "Value": "'pt-suggestions-accepted'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}