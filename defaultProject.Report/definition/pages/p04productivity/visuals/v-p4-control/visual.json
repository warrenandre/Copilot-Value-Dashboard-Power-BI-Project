{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "v-p4-control",
  "position": {
    "x": 960,
    "y": 220,
    "z": 8000,
    "height": 420,
    "width": 960,
    "tabOrder": 8000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimDate"
                    }
                  },
                  "Property": "WeekStart"
                }
              },
              "queryRef": "DimDate.WeekStart",
              "nativeQueryRef": "DimDate.WeekStart",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimBusinessUnit"
                    }
                  },
                  "Property": "BusinessUnit"
                }
              },
              "queryRef": "DimBusinessUnit.BusinessUnit",
              "nativeQueryRef": "DimBusinessUnit.BusinessUnit"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Median PR Cycle Time (hrs)"
                }
              },
              "queryRef": "_Measures.Median PR Cycle Time (hrs)",
              "nativeQueryRef": "Median PR Cycle Time (hrs)"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "visualTooltip": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "section": {
              "expr": {
                "Literal": {
                  "Value": "'pt-median-pr-cycle-time-hrs'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}